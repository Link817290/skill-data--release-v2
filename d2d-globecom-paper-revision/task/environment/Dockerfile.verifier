FROM harbor-claude-code-aggregated:1.3

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /tests
COPY tests/ /tests/
COPY environment/workspace/ /workspace/

# The declared verifier dependency is already part of the base image. Fail the
# build if the tag ever drifts instead of silently changing PDF observations.
RUN python3 -c "import pymupdf; assert pymupdf.__version__ == '1.28.2'" \
    && test -x /tests/test.sh \
    && test -r /workspace/materials/D2D_conf.zip

ENTRYPOINT ["/bin/sh", "/tests/test.sh"]
