FROM harbor-claude-code-aggregated:1.3
USER root
WORKDIR /package/task
COPY task/environment/wheels/ /opt/delivery-wheels/
RUN python3 -m pip install --no-index --find-links=/opt/delivery-wheels networkx==3.5 pyproj==3.7.2
COPY task/ /package/task/
COPY golden/ /package/golden/
COPY RUBRIC.md /package/RUBRIC.md
RUN chown -R 20005:0 /package
USER 20005
