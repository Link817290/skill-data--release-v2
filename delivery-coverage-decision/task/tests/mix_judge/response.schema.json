{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery decision semantic review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passed",
    "reference_conflict",
    "criteria",
    "notes"
  ],
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "reference_conflict": {
      "type": "boolean"
    },
    "criteria": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "reason",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "recommendation_meaning",
              "priority_and_tradeoffs",
              "evidence_interpretation",
              "scope_and_limits"
            ]
          },
          "score": {
            "type": "number",
            "enum": [
              0,
              0.5,
              1
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "quote"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "quote_origin": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
