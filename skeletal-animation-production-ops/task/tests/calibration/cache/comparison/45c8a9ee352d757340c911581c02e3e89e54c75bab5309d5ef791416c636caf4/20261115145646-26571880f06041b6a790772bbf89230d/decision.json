      "quoted_lines": [
        {
          "line_number": 6,
          "text": "def sample(project,out,godot=None):\n"
        },
        {
          "line_number": 7,
          "text": "    out=Path(out).resolve();out.mkdir(parents=True,exist_ok=True)\n"
        },
        {
          "line_number": 8,
          "text": "    cmd=[godot_binary(godot),'--headless','--fixed-fps','60','--path',str(Path(project).resolve()),'--script',str(Path(__file__).with_name('sample_effects.gd')),'--',str(out),'--verification']\n"
        },
        {
          "line_number": 9,
          "text": "    p=subprocess.run(cmd,capture_output=True,text=True,encoding='utf-8',errors='replace',timeout=120)\n"
        },
        {
          "line_number": 10,
          "text": "    (out/'engine.log').write_text(p.stdout+p.stderr,encoding='utf-8')\n"
        },
        {
          "line_number": 11,
          "text": "    if p.returncode or 'ERROR:' in p.stderr:raise RuntimeError(p.stdout+p.stderr)\n"
        },
        {
          "line_number": 13,
          "text": "def render(out):\n"
        },
        {
          "line_number": 14,
          "text": "    out=Path(out);groups={}\n"
        },
        {
          "line_number": 15,
          "text": "    with (out/'scene-frames.csv').open(encoding='utf-8',newline='') as f:\n"
        },
        {
          "line_number": 16,
          "text": "        for r in csv.DictReader(f):\n"
        },
        {
          "line_number": 17,
          "text": "            group=groups.setdefault(int(r['frame']),[])\n"
        },
        {
          "line_number": 18,
          "text": "            if r['node']:group.append(r)\n"
        },
        {
          "line_number": 19,
          "text": "    sheet=Image.new('RGB',(4*640,2*390),(20,30,40))\n"
        },
        {
          "line_number": 20,
          "text": "    sampled=[20,34,44,58]\n"
        },
        {
          "line_number": 21,
          "text": "    for row,(theme,bg,ink) in enumerate([('dark',(15,25,40,255),'#A7C4D1'),('light',(230,236,241,255),'#385465')]):\n"
        },
        {
          "line_number": 22,
          "text": "        frames=[]\n"
        },
        {
          "line_number": 23,
          "text": "        for frame in range(0,121,2):\n"
        },
        {
          "line_number": 24,
          "text": "            im=Image.new('RGBA',(640,360),bg);d=ImageDraw.Draw(im)\n"
        },
        {
          "line_number": 29,
          "text": "            for r in groups[frame]:\n"
        },
        {
          "line_number": 30,
          "text": "                if r.get('visible','true').lower()!='true':continue\n"
        },
        {
          "line_number": 31,
          "text": "                src=Image.open(out/r['texture']).convert('RGBA')\n"
        },
        {
          "line_number": 32,
          "text": "                channels=src.split()\n"
        },
        {
          "line_number": 33,
          "text": "                src=Image.merge('RGBA',[ch.point(lambda x,f=float(r.get(k,1)):max(0,min(255,round(x*f)))) for ch,k in zip(channels,['red','green','blue','alpha'])])\n"
        },
        {
          "line_number": 34,
          "text": "                a,b,c,e,tx,ty,ox,oy=[float(r[k]) for k in ['a','b','c','d','tx','ty','offset_x','offset_y']]\n"
        },
        {
          "line_number": 38,
          "text": "                coeff=(ia,ib,-ia*tx-ib*ty-ox,ic,ie,-ic*tx-ie*ty-oy)\n"
        },
        {
          "line_number": 39,
          "text": "                transformed=src.transform(im.size,Image.Transform.AFFINE,coeff,resample=Image.Resampling.BICUBIC)\n"
        },
        {
          "line_number": 40,
          "text": "                if int(r['blend'])==1:\n"
        },
        {
          "line_number": 41,
          "text": "                    rgb=ImageChops.multiply(transformed.convert('RGB'),Image.merge('RGB',[transformed.getchannel('A')]*3))\n"
        },
        {
          "line_number": 42,
          "text": "                    im=ImageChops.add(im.convert('RGB'),rgb).convert('RGBA')\n"
        },
        {
          "line_number": 43,
          "text": "                else:im=Image.alpha_composite(im,transformed)\n"
        }
      ]
    }
