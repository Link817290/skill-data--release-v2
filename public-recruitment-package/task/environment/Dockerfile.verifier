FROM harbor-claude-code-aggregated:1.3

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /task
COPY task/tests/ /task/tests/
COPY task/instruction.md /task/instruction.md
COPY golden/ /task/golden/
RUN test -s /task/tests/validator.py && test -s /task/tests/semantic_judge.py
CMD ["/bin/sh"]
