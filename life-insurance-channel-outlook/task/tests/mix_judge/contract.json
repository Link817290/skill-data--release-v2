{
  "dimensions": {
    "object_scope_binding": 0.15,
    "polarity_and_status": 0.2,
    "requirement_coverage": 0.4,
    "source_fidelity": 0.25
  },
  "golden_normalization": "min(1, semantic_score / golden_semantic_score)",
  "ownership": {
    "program": [
      "arithmetic",
      "formulas",
      "file contract",
      "structure"
    ],
    "semantic": [
      "requirement coverage",
      "source fidelity",
      "polarity/status",
      "object/scope binding"
    ]
  },
  "schema": "source-bound-semantic-score-v1",
  "semantic_center": 0.75,
  "semantic_weight": 0.075,
  "settlement": "preserve exact 1; otherwise 0.97 * clamp(program_score + 0.075 * (normalized_semantic_score - 0.75), 0, 1)",
  "shared_scale": 0.97
}
