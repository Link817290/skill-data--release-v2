FROM harbor-claude-code-aggregated:1.3

USER root
WORKDIR /workspace
COPY task/tests/ /tests/
COPY task/environment/workspace/materials/ /materials/
COPY task/instruction.md /task/instruction.md
RUN test -s /materials/03_原始材料.xlsx \
    && echo "b2f77b725afbe9751721af8016e2a1fb2ca07999084c2e499435bcb2e59c9185  /materials/03_原始材料.xlsx" | sha256sum -c - \
    && mkdir -p /workspace/output /logs/verifier /logs/artifacts
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
CMD ["sh"]
