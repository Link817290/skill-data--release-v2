FROM harbor-claude-code-aggregated:1.3

USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY task/tests/ /tests/
COPY task/environment/workspace/ /workspace/
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN mkdir -p /logs/verifier /logs/artifacts \
    && test -s /tests/validator.py \
    && test -s /tests/ground_truth.json \
    && test -s /workspace/general_average_adjustment.pdf
CMD ["bash", "/tests/test.sh"]
