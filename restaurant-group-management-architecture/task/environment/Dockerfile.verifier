FROM harbor-claude-code-aggregated:1.3

USER root
WORKDIR /workspace
COPY task/ /task/
COPY golden/ /task/golden/
COPY task/environment/workspace/ /workspace/
RUN test -f /task/tests/program_judge/task_judge.py \
    && test -f /task/tests/program_judge/semantic_judge.py \
    && chmod +x /task/tests/test.sh \
    && mkdir -p /workspace/output /logs/verifier /logs/artifacts
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
CMD ["/bin/sh"]
