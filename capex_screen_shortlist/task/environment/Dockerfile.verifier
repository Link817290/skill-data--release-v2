FROM harbor-claude-code-aggregated:1.3

USER root
WORKDIR /workspace
COPY task/tests/ /tests/
COPY task/environment/workspace/ /trusted-inputs/
COPY task/environment/skills/audit-capital-expansion-screen/ /professional_rules/audit-capital-expansion-screen/
COPY task/instruction.md /task/instruction.md
COPY golden/ /golden/
RUN test -f /trusted-inputs/candidate_universe.csv \
    && test "$(find /trusted-inputs/structured-data/provider-snapshots -name '*.json' | wc -l)" = 60 \
    && mkdir -p /logs/verifier /logs/artifacts \
    && chown -R 20005:0 /workspace /logs
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 20005
CMD ["sh"]
