{
  "deliverable": "/workspace/regime_map.xlsx",
  "sheet": "Regime Map",
  "required_columns": [
    "sample_id",
    "regime_label",
    "action",
    "evidence_ids",
    "contradiction_flag",
    "review_flag",
    "rationale"
  ],
  "regime_label_enum": [
    "SIGNAL",
    "NOISE",
    "MIXED",
    "REVIEW"
  ],
  "action_enum": [
    "ADD_RISK",
    "REDUCE_RISK",
    "HOLD",
    "ROTATE_STYLE",
    "ROTATE_INDUSTRY",
    "REVIEW_ONLY"
  ],
  "boolean_enum": [
    "TRUE",
    "FALSE"
  ],
  "evidence_id_enum": [
    "E_PRICE_PERSISTENCE",
    "E_BOTTOM_ODDS",
    "E_VALUATION_STRETCHED",
    "E_EQUITY_RISK_PREMIUM",
    "E_LIQUIDITY_CONFIRM",
    "E_LIQUIDITY_WITHDRAW",
    "E_CREDIT_EASING",
    "E_CREDIT_TIGHTENING",
    "E_EARNINGS_PULSE",
    "E_BREADTH_CONFIRM",
    "E_BREADTH_NARROW",
    "E_STYLE_DIVERGENCE",
    "E_POLICY_SUPPORT",
    "E_EVENT_NOISE",
    "E_VOLATILITY_SHOCK",
    "E_INSUFFICIENT_EVIDENCE"
  ],
  "event_id_prefix": "EVT_"
}
