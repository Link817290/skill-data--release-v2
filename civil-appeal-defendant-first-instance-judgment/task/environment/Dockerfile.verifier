FROM harbor-claude-code-aggregated:1.3
USER root
WORKDIR /workspace
RUN python3 -c "import docx; assert docx.__version__ == '1.2.0'"
COPY task/tests/ /tests/
COPY task/environment/workspace/ /workspace/
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN mkdir -p /workspace/artifacts /logs/verifier && chown -R 20005:0 /workspace /logs
USER 20005
CMD ["/bin/sh"]
