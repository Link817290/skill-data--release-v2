{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "passed": {"type": "boolean"},
    "reference_conflict": {"type": "boolean"},
    "criteria": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "enum": ["section_boundary", "family_coverage", "equivalent_decomposition", "quantity_basis", "technical_characteristics", "uncertainty_conflict_control", "completed_closure", "audit_control"]},
          "score": {"type": "number", "enum": [0, 0.25, 0.5, 0.75, 1]},
          "reason": {"type": "string"},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"id": {"type": "string", "pattern": "^C"}, "quote": {"type": "string"}},
                "required": ["id", "quote"]
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"id": {"type": "string", "pattern": "^[GF]"}, "quote": {"type": "string"}},
                "required": ["id", "quote"]
              },
              "additional": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {"id": {"type": "string"}, "quote": {"type": "string"}},
                  "required": ["id", "quote"]
                }
              }
            },
            "required": ["candidate", "source", "additional"]
          }
        },
        "required": ["id", "score", "reason", "evidence"]
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["passed", "reference_conflict", "criteria", "notes"]
}
