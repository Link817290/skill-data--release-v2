FROM harbor-claude-code-aggregated:1.3

USER root
WORKDIR /workspace
COPY task/tests/ /task/tests/
RUN command -v libreoffice >/dev/null \
    && python3 -c "import openpyxl" \
    && test -s /task/tests/validator.py \
    && test -s /task/tests/semantic_judge.py \
    && chmod +x /task/tests/test.sh \
    && mkdir -p /logs/verifier /logs/artifacts
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
CMD ["/bin/sh"]
