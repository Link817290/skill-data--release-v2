  "construction_issues": [
    {"issue_id": "C_HANDSHAKE_PD", "question": "Do Type-C attachment and PD contract formation resolve the claimed handshaking-period boundary in light of the patent specification's BC1.2 example?"},
    {"issue_id": "C_CC_DATA_CONDUCTOR", "question": "Does the Type-C configuration channel resolve the claims' USB data-conductor language?"},
    {"issue_id": "C_POWER_MAGNITUDE", "question": "Do voltage and current fields necessarily resolve the issued requirement for information about a magnitude of power?"},
    {"issue_id": "C_OUTPUT_AS_CAPABILITY_MESSAGE", "question": "Does changing VBUS in response to a powered-device command resolve charger-originated communication of available output levels?"},
    {"issue_id": "C_STATIC_LEVEL_AS_TOGGLE_PATTERN", "question": "Does maintaining one lookup-table voltage state resolve a pattern of voltage-level toggles?"},
    {"issue_id": "C_OUTPUT_CHANGE_AS_BEGIN_DATA", "question": "Does beginning an output-voltage change resolve beginning digital-data communication in response to the received pattern?"},
    {"issue_id": "C_HVDCP_AS_NORMAL_OPERATION", "question": "Does entry into HVDCP mode resolve the claimed beginning of normal operation?"},
    {"issue_id": "C_EQUAL_LEVEL_AS_PHYSICAL_SHORT", "question": "Do equal observed voltages on two conductors resolve a requirement that the charging device shorts those conductors together?"}
  ],
