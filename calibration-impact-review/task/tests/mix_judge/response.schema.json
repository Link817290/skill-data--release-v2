{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "reference_conflict": {
      "type": "boolean"
    },
    "criteria": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "conclusion",
              "evidence",
              "tradeoffs",
              "scope"
            ]
          },
          "score": {
            "type": "number",
            "enum": [
              0,
              0.5,
              1
            ]
          },
          "reason": {
            "type": "string"
          },
          "meets_brief": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "quote"
              ]
            }
          }
        },
        "required": [
          "id",
          "score",
          "meets_brief",
          "reason",
          "evidence"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "passed",
    "reference_conflict",
    "criteria",
    "notes"
  ]
}
